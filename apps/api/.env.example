# ─────────────────────────────────────────────────
# Tuite API — Environment Variables
# ─────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3001

# Database
# Connect to Postgres via the shared transaction-mode pooler (used for app connections)
DATABASE_URL="postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres"
# JWT
JWT_SECRET=super-secret-change-me-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=20
