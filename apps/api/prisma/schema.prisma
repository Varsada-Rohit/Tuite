// ──────────────────────────────────────────────────────────
// Tuite Platform — Prisma Schema
// ──────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  TEACHER
  STUDENT
  PARENT
}

enum FeatureName {
  NOTES
  VIDEO_LECTURES
  ONLINE_TESTS
  COMMUNICATION
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ─── Models ──────────────────────────────────────────────

model Tenant {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(50)
  logo_url        String?  @db.VarChar(2048)
  primary_color   String   @default("#1E40AF") @db.VarChar(7)
  secondary_color String   @default("#F3F4F6") @db.VarChar(7)
  contact_email   String?  @db.VarChar(320)
  contact_phone   String?  @db.VarChar(20)
  address         String?  @db.Text
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relations
  users          User[]
  feature_flags  TenantFeatureFlag[]
  batches        Batch[]
  students       Student[]
  attendance     Attendance[]
  leave_requests LeaveRequest[]

  @@index([slug])
  @@map("tenants")
}

model TenantFeatureFlag {
  id           String      @id @default(uuid()) @db.Uuid
  tenant_id    String      @db.Uuid
  feature_name FeatureName
  is_enabled   Boolean     @default(false)

  // Relations
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, feature_name])
  @@index([tenant_id])
  @@map("tenant_feature_flags")
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  tenant_id  String?  @db.Uuid
  phone      String   @db.VarChar(20)
  full_name  String?  @db.VarChar(255)
  role       Role
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  tenant              Tenant?        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  refresh_tokens      RefreshToken[]
  teacher_batches     TeacherBatch[]
  marked_attendance   Attendance[]   @relation("MarkedBy")
  reviewed_leaves     LeaveRequest[] @relation("ReviewedBy")

  // Unique constraint for tenant-scoped phone.
  // Note: For SUPER_ADMIN (tenant_id = null), we add a partial unique
  // index via a raw SQL migration to handle NULL properly.
  @@unique([tenant_id, phone])
  @@index([tenant_id])
  @@index([phone])
  @@map("users")
}

model Batch {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  teachers       TeacherBatch[]
  students       StudentBatch[]
  attendance     Attendance[]
  leave_requests LeaveRequest[]

  @@index([tenant_id])
  @@map("batches")
}

model TeacherBatch {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  batch_id    String   @db.Uuid
  assigned_at DateTime @default(now())

  // Relations
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@unique([user_id, batch_id])
  @@index([batch_id])
  @@map("teacher_batches")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @db.VarChar(64)
  expires_at DateTime
  revoked    Boolean  @default(false)
  created_at DateTime @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([token_hash])
  @@index([user_id])
  @@map("refresh_tokens")
}

// ─── Phase 3: Student Roster & Attendance ────

model Student {
  id            String    @id @default(uuid()) @db.Uuid
  tenant_id     String    @db.Uuid
  full_name     String    @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  email         String?   @db.VarChar(320)
  gender        Gender?
  date_of_birth DateTime? @db.Date
  address       String?   @db.Text

  // Parent contact details
  parent_name   String?   @db.VarChar(255)
  parent_phone  String?   @db.VarChar(20)
  parent_email  String?   @db.VarChar(320)

  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Relations
  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  batches        StudentBatch[]
  attendance     Attendance[]
  leave_requests LeaveRequest[]

  @@index([tenant_id])
  @@index([tenant_id, full_name])
  @@map("students")
}

model StudentBatch {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  student_id  String   @db.Uuid
  batch_id    String   @db.Uuid
  enrolled_at DateTime @default(now())

  // Relations
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@unique([student_id, batch_id])
  @@index([tenant_id])
  @@index([batch_id])
  @@map("student_batches")
}

model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  tenant_id  String           @db.Uuid
  batch_id   String           @db.Uuid
  student_id String           @db.Uuid
  date       DateTime         @db.Date
  status     AttendanceStatus
  marked_by  String           @db.Uuid
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt

  // Relations
  tenant  Tenant  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  marker  User    @relation("MarkedBy", fields: [marked_by], references: [id])

  // Prevent duplicate attendance for same student-batch-date
  @@unique([batch_id, student_id, date])
  @@index([tenant_id])
  @@index([batch_id, date])
  @@index([student_id])
  @@map("attendance")
}

model LeaveRequest {
  id          String      @id @default(uuid()) @db.Uuid
  tenant_id   String      @db.Uuid
  student_id  String      @db.Uuid
  batch_id    String      @db.Uuid
  start_date  DateTime    @db.Date
  end_date    DateTime    @db.Date
  reason      String      @db.Text
  status      LeaveStatus @default(PENDING)
  reviewed_by String?     @db.Uuid
  reviewed_at DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  batch    Batch    @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  reviewer User?    @relation("ReviewedBy", fields: [reviewed_by], references: [id])

  @@index([tenant_id])
  @@index([student_id])
  @@index([tenant_id, status])
  @@map("leave_requests")
}
